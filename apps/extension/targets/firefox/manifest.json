{
  "manifest_version": 3,
  "name": "Prism",
  "version": "0.1.0",
  "description": "Run capability-scoped Prism mods.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeNetRequest",
    "storage",
    "userScripts",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://www.reddit.com/*",
    "https://sponsor.ajay.app/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bundled-mods/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "scripts": [
      "dist/service-worker.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
